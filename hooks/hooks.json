{
  "description": "git commit 시 intent 기록을 제안한다(제안만 하고, 기록은 intent-record가 수행한다).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-on-commit.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
